# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 총괄관리자의 계정 생성/삭제(Admin API)와 키오스크 트랜잭션에만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# 앱 설정
# ─────────────────────────────────────────────────────────────
# 키오스크 링크를 만들 때 사용할 공개 URL (예: https://erp.whattheburger.co.kr)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# scripts/seed.ts 가 만들 최초 총괄관리자 계정
SEED_HQ_EMAIL=admin@whattheburger.co.kr
SEED_HQ_PASSWORD=change-this-password
